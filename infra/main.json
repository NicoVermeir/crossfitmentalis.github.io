{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.46.1.21595",
      "templateHash": "8927820419561394583"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for the App Service resources."
      }
    },
    "appName": {
      "type": "string",
      "defaultValue": "crossfitmentalis",
      "metadata": {
        "description": "Globally unique App Service site name."
      }
    },
    "planName": {
      "type": "string",
      "defaultValue": "crossfitmentalis-plan",
      "metadata": {
        "description": "Name of the Linux App Service Plan."
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {
        "workload": "crossfit-mentalis-website",
        "managedBy": "bicep"
      },
      "metadata": {
        "description": "Tags applied to all resources created by this deployment."
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2024-11-01",
      "name": "[parameters('planName')]",
      "location": "[parameters('location')]",
      "kind": "linux",
      "sku": {
        "name": "B1",
        "tier": "Basic"
      },
      "tags": "[union(parameters('tags'), createObject('azd-service-name', 'crossfitmentalis'))]",
      "properties": {
        "reserved": true
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2024-11-01",
      "name": "[parameters('appName')]",
      "location": "[parameters('location')]",
      "kind": "app,linux,node",
      "tags": "[union(parameters('tags'), createObject('azd-service-name', 'crossfitmentalis'))]",
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', parameters('planName'))]",
        "httpsOnly": true,
        "siteConfig": {
          "linuxFxVersion": "NODE|20-lts",
          "appCommandLine": "node server.js",
          "alwaysOn": true,
          "ftpsState": "Disabled",
          "minTlsVersion": "1.2",
          "http20Enabled": true
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', parameters('planName'))]"
      ]
    }
  ],
  "outputs": {
    "appName": {
      "type": "string",
      "value": "[parameters('appName')]"
    },
    "defaultHostName": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Web/sites', parameters('appName')), '2024-11-01').defaultHostName]"
    },
    "appServicePlanId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Web/serverfarms', parameters('planName'))]"
    }
  }
}